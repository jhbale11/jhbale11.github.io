---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import { site, news } from '../data/site';
import { honors } from '../data/cv';
import { getPubs } from '../lib/pubs';
import { publisherLabel } from '../lib/links';

const pubs = await getPubs();
const selected = pubs.filter((p) => p.data.selected);
const upcoming = news.filter((n) => n.upcoming);
const past = news.filter((n) => !n.upcoming);
const interests = ['🤝 Human-AI Interaction', '🧩 LLM-Augmented Interfaces', '⚖️ Legal Tech', '🩺 Health Informatics', '📚 Education', '✍️ Writing & Translation'];
---
<Base>
  <section class="wrap hero">
    <div>
      <h1 class="home-title">{site.name}<span class="ko" lang="ko">{site.koreanName}</span></h1>
      <p class="home-sub">👋 HAI &amp; LLM Researcher · Ph.D. Candidate at Seoul National University</p>
      <div class="bio">
        <p>
          I am a Human-AI Interaction (HAI) and LLM researcher, and a Ph.D. candidate in the
          <a href={site.programUrl} target="_blank" rel="noopener">Interdisciplinary Program in Artificial Intelligence</a> at
          <a href={site.universityUrl} target="_blank" rel="noopener"><img class="aff" src="/images/logo/snu.svg" alt="" />Seoul National University</a>,
          advised by <a href={site.advisorUrl} target="_blank" rel="noopener">Bongwon Suh</a> in the
          <a href={site.labUrl} target="_blank" rel="noopener"><img class="aff" src="/images/logo/hcc.png" alt="" />Human-Centered Computing Lab</a>.
          Within HAI, I study <strong>human-centered interactive systems</strong>.
        </p>
        <p>
          Model capability has improved rapidly, but the benefit people actually feel has not grown at the same pace.
          The <strong>tacit knowledge</strong> that domain experts build over years of experience, what they base their judgments on and
          how they make them, has not been carried into the structure of LLM-based systems. It still has to pass through a single
          window: the chat box.
        </p>
        <p>
          So my research draws out this tacit knowledge and moves it into the structure of interactive systems. I find problems in the
          field, in expert domains such as <strong>law</strong> and <strong>medicine</strong>, build the full stack myself, from data pipelines
          and agent orchestration to the interactive frontend that lets people see and directly handle it, and derive design insights
          through evaluations with real users.
        </p>
        <p>
          As generation keeps getting easier and human judgment and responsibility matter more in the trajectory of AI and robotics,
          I aim to externalize the tacit knowledge that exists in different forms across domains into structures people can see and
          work with directly, and to propose <strong>generalized guidelines for human-centered AI system design</strong>.
        </p>
      </div>
      <div class="contact-line">
        <a href={`mailto:${site.email}`}><Icons name="mail" />{site.email}</a>
        <a href={site.scholar} target="_blank" rel="noopener"><Icons name="scholar" />Google Scholar</a>
        <a href={site.linkedin} target="_blank" rel="noopener"><Icons name="linkedin" />LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener"><Icons name="github" />GitHub</a>
        <a href={site.cvPdf} target="_blank" rel="noopener"><Icons name="cv" />CV</a>
      </div>
    </div>
    <img class="hero-photo" src="/images/profile.jpg" alt={`Portrait of ${site.name}`} width="220" height="220" />
  </section>

  <section class="wrap section">
    <p class="section-title"><span><span class="emoji">📌</span>Selected publications</span><a href="/publications">View all {pubs.length} →</a></p>
    <div class="scroller-shell">
      <button class="scroll-btn l" type="button" aria-label="Scroll left" data-dir="-1">←</button>
      <div class="scroller" data-scroller>
        <div class="scroller-inner">
          {selected.map((p) => {
            const d = p.data;
            const publisher = d.doi ?? (d.url && d.url !== d.arxiv ? d.url : undefined);
            return (
              <div class="pcard">
                <a class="pcard-img" href={`/publications/${p.id}`} aria-hidden="true" tabindex="-1">
                  {d.teaser ? <img src={d.teaser} alt="" loading="lazy" /> : <span class="ph">📄</span>}
                </a>
                <div class="pcard-body">
                  <div class="pcard-head">
                    <p class="pcard-title"><a href={`/publications/${p.id}`}>{d.shortTitle ?? d.title}</a></p>
                    <span class="venue-chip">{d.venueShort.replace(/ (20)(\d\d)/, " '$2")}</span>
                  </div>
                  <p class="pcard-desc">{d.blurb}</p>
                  {d.award && <p class="pcard-award">🏆 {d.award}</p>}
                  <p class="pcard-meta">
                    <a href={`/publications/${p.id}`}><Icons name="page" />Details</a>
                    {d.pdf && <a href={d.pdf} target="_blank" rel="noopener"><Icons name="pdf" />PDF</a>}
                    {publisher && <a href={publisher} target="_blank" rel="noopener"><Icons name="doi" />{publisherLabel(publisher)}</a>}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <button class="scroll-btn r" type="button" aria-label="Scroll right" data-dir="1">→</button>
    </div>
  </section>

  <section class="wrap section two-col">
    <div>
      <p class="section-title"><span><span class="emoji">📰</span>News</span></p>
      {past.map((n) => (
        <div class="news-item">
          <span class="emoji" aria-hidden="true">{n.emoji}</span>
          <div>
            <p class="news-date">{n.date}</p>
            <p class="news-title">{n.href ? <a href={n.href}>{n.title}</a> : n.title}</p>
            <p class="news-text">{n.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div>
      <p class="section-title"><span><span class="emoji">🗓️</span>Upcoming</span></p>
      <ul class="side-list">
        {upcoming.map((n) => (
          <li><span aria-hidden="true">{n.emoji}</span><span><span class="d">{n.date}</span>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</span></li>
        ))}
      </ul>
      <p class="section-title" style="margin-top: 2rem"><span><span class="emoji">🏅</span>Honors</span></p>
      <ul class="side-list">
        {honors.slice(0, 3).map((h) => (
          <li><span aria-hidden="true">🏆</span><span><span class="d">{h.when}</span>{h.href ? <a href={h.href}>{h.title}</a> : h.title}</span></li>
        ))}
      </ul>
      <p class="section-title" style="margin-top: 2rem"><span><span class="emoji">🔍</span>Interests</span></p>
      <div class="interests">{interests.map((t) => <span class="tag">{t}</span>)}</div>
    </div>
  </section>
</Base>

<script>
  const shell = document.querySelector<HTMLElement>('.scroller-shell');
  const sc = shell?.querySelector<HTMLElement>('[data-scroller]');
  const btns = shell?.querySelectorAll<HTMLButtonElement>('.scroll-btn') ?? [];
  function update() {
    if (!sc) return;
    const max = sc.scrollWidth - sc.clientWidth - 1;
    btns.forEach((b) => { b.disabled = b.dataset.dir === '-1' ? sc.scrollLeft <= 0 : sc.scrollLeft >= max; });
  }
  btns.forEach((b) => b.addEventListener('click', () => sc?.scrollBy({ left: Number(b.dataset.dir) * 460, behavior: 'smooth' })));
  sc?.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
