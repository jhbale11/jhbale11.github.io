---
import Base from '../layouts/Base.astro';
import Authors from '../components/Authors.astro';
import Badges from '../components/Badges.astro';
import { site, news } from '../data/site';
import { getPubs } from '../lib/pubs';

const pubs = await getPubs();
const selected = pubs.filter((p) => p.data.selected).slice(0, 6);
const counts = {
  total: pubs.length,
  first: pubs.filter((p) => p.data.category === 'first-author').length,
  awards: pubs.filter((p) => p.data.award).length,
};
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <div class="eyebrow" style="color: var(--hero-muted)">{site.role} · {site.university}</div>
        <h1 style="margin-top: 0.4rem">{site.name}<span class="ko-name">{site.koreanName}</span></h1>
        <p class="title">
          <a href={site.labUrl} target="_blank" rel="noopener">{site.lab}</a><br />
          {site.program}, {site.university}
        </p>
        <p class="tagline">{site.tagline}</p>
        <div class="hero-links">
          <a class="primary" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {site.email}
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
            LinkedIn
          </a>
          <a href={site.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5z"/></svg>
            GitHub
          </a>
          <a href={site.cvPdf} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3"/></svg>
            CV (PDF)
          </a>
        </div>
      </div>
      <img class="portrait" src="/images/profile.jpg" alt={`Portrait of ${site.name}`} width="220" height="220" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head"><h2>About</h2></div>
      <p>
        I am a Ph.D. candidate at the <a href={site.labUrl} target="_blank" rel="noopener">Human-Centered Computing Lab</a>
        at Seoul National University, advised by Prof. Bongwon Suh. I work on Human-Computer Interaction, LLM-augmented
        interface design for domain experts, and human-AI collaboration. My dissertation, <em>LLM-Augmented Interface
        Design for Domain Experts</em>, is expected in February 2027.
      </p>
      <p class="thesis">“{site.thesis}”</p>
      <p style="margin-top: 1rem">
        I build and study systems with lawyers, clinicians, nurses, teachers, translators and writers, grounding interface
        decisions in HCI theory such as reification, distributed cognition, articulation work and boundary infrastructure.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Research interests</h2></div>
      <div class="grid-3">
        {site.interests.map((it, i) => (
          <div class="card interest">
            <div class="num">0{i + 1}</div>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected publications</h2>
        <a class="more" href="/publications">All {counts.total} publications →</a>
      </div>
      <div class="sel-grid">
        {selected.map((p) => (
          <a class="card sel" href={`/publications/${p.id}`} style="color: inherit; text-decoration: none">
            <div class:list={['pub-thumb', { 'placeholder-bg': !p.data.teaser }]}>
              {p.data.teaser ? <img src={p.data.teaser} alt={p.data.teaserAlt ?? ''} loading="lazy" /> : <span class="placeholder">{p.data.venueShort}</span>}
            </div>
            <div class="sel-body">
              <div class="pub-venue"><span class="short">{p.data.venueShort}</span>{p.data.presentation ? ` · ${p.data.presentation}` : ''}</div>
              <div class="pub-title">{p.data.title}</div>
              <Authors authors={p.data.authors} class="small" />
              <Badges award={p.data.award} status={p.data.status} showFormat={false} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head"><h2>News</h2></div>
      <ul class="news">
        {news.map((n) => (
          <li>
            <span class="date">{n.date}</span>
            <span>{n.href ? <a href={n.href}>{n.text}</a> : n.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card contact">
        <div>
          <h2>Get in touch</h2>
          <p class="muted">Happy to talk about LLM interfaces for expert work, human-AI teaming, or collaborations.</p>
        </div>
        <div class="btns">
          <a class="btn" href={`mailto:${site.email}`}>Email</a>
          <a class="btn ghost" href="/cv">View CV</a>
        </div>
      </div>
    </div>
  </section>
</Base>
