---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import PubItem from '../components/PubItem.astro';
import { site, news } from '../data/site';
import { getPubs } from '../lib/pubs';

const pubs = await getPubs();
const selected = pubs.filter((p) => p.data.selected);
---
<Base>
  <section class="wrap profile">
    <img src="/images/profile.jpg" alt={`Portrait of ${site.name}`} width="200" height="200" />
    <div>
      <h1>{site.name}<span class="ko">{site.koreanName}</span></h1>
      <div class="role">{site.role} · <a href={site.labUrl} target="_blank" rel="noopener">{site.lab}</a>, Seoul National University</div>
      <div class="bio">
        <p>
          I am a Ph.D. candidate in the <strong>{site.program}</strong> at Seoul National University, advised by
          <strong>Prof. Bongwon Suh</strong> in the <a href={site.labUrl} target="_blank" rel="noopener">Human-Centered Computing Lab</a>.
          My research spans <strong>Human-Computer Interaction</strong>, <strong>LLM-augmented interface design for domain experts</strong>,
          and <strong>human-AI collaboration</strong>.
        </p>
        <p>
          I build and study systems with lawyers, clinicians, nurses, teachers, translators and writers. The thread through this work
          is a simple claim: <em>{site.thesis}</em> I ground interface decisions in HCI theory such as reification, distributed
          cognition, articulation work and boundary infrastructure.
        </p>
      </div>
      <div class="icons">
        <a href={`mailto:${site.email}`} title="Email"><Icons name="mail" /> Email</a>
        <a href={site.scholar} target="_blank" rel="noopener" title="Google Scholar"><Icons name="scholar" /> Scholar</a>
        <a href={site.linkedin} target="_blank" rel="noopener" title="LinkedIn"><Icons name="linkedin" /> LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener" title="GitHub"><Icons name="github" /> GitHub</a>
        <a href={site.cvPdf} target="_blank" rel="noopener" title="CV (PDF)"><Icons name="cv" /> CV</a>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="sec-head"><h2>Research interests</h2></div>
    <div class="chips">
      {['Human-AI Interaction', 'LLM-Augmented Interfaces', 'Domain Experts', 'Human-AI Collaboration', 'Legal Tech', 'Health Informatics', 'Education', 'Creative Writing & Translation'].map((c) => <span class="chip">{c}</span>)}
    </div>
  </section>

  <section class="wrap sec">
    <div class="sec-head"><h2>📌 News</h2></div>
    <ul class="news">
      {news.map((n) => (
        <li><span class="d">{n.date}</span><span>{n.href ? <a href={n.href} set:html={n.text} /> : <span set:html={n.text} />}</span></li>
      ))}
    </ul>
  </section>

  <section class="wrap sec">
    <div class="sec-head">
      <h2>Selected publications</h2>
      <a href="/publications">All {pubs.length} publications →</a>
    </div>
    <p class="legend"><sup>†</sup> equal contribution</p>
    <ul class="plist">
      {selected.map((p) => <PubItem pub={p} />)}
    </ul>
  </section>
</Base>
