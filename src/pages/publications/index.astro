---
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import { getPubs, groupByType } from '../../lib/pubs';

const pubs = await getPubs();
const groups = groupByType(pubs);
const firstCount = pubs.filter((p) => p.data.category === 'first-author').length;
---
<Base title="Publications" description="Publications by Junghwan Kim: HCI, LLM-augmented interfaces for domain experts, and human-AI collaboration.">
  <section class="wrap" style="padding-top: 2.5rem">
    <div class="sec-head" style="margin-bottom: 0.5rem">
      <h1>Publications</h1>
      <a href="https://scholar.google.com/citations?user=j03Cb5MAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar →</a>
    </div>
    <p class="muted" style="max-width: 60ch">{pubs.length} publications. Each entry has its own page with the abstract, links and BibTeX.</p>
    <div class="toolbar">
      <button class="toggle" type="button" aria-pressed="false" data-first-toggle><span class="knob" aria-hidden="true"></span>First-author only ({firstCount})</button>
      <span class="legend" style="margin: 0"><sup>†</sup> equal contribution · 🏆 award</span>
    </div>

    {groups.map((g) => (
      <div class="group" data-group={g.key}>
        <h2>{g.label}</h2>
        <ul class="plist">{g.pubs.map((p) => <PubItem pub={p} />)}</ul>
      </div>
    ))}
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-first-toggle]');
  const items = document.querySelectorAll<HTMLElement>('.pub');
  const groups = document.querySelectorAll<HTMLElement>('.group');
  function apply(on: boolean) {
    btn?.setAttribute('aria-pressed', String(on));
    items.forEach((el) => { el.hidden = on && el.dataset.first !== '1'; });
    groups.forEach((g) => { g.hidden = !g.querySelector('.pub:not([hidden])'); });
    try { history.replaceState(null, '', on ? '?first=1' : location.pathname); } catch {}
  }
  btn?.addEventListener('click', () => apply(btn.getAttribute('aria-pressed') !== 'true'));
  if (new URLSearchParams(location.search).get('first') === '1') apply(true);
</script>
