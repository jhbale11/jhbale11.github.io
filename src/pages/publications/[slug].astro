---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Authors from '../../components/Authors.astro';
import Icons from '../../components/Icons.astro';
import { getPubs, bibtex } from '../../lib/pubs';
import { publisherLabel } from '../../lib/links';

export async function getStaticPaths() {
  const pubs = await getPubs();
  return pubs.map((pub, i) => ({ params: { slug: pub.id }, props: { pub, prev: pubs[i - 1] ?? null, next: pubs[i + 1] ?? null } }));
}

const { pub, prev, next } = Astro.props;
const d = pub.data;
const { Content } = await render(pub);
const bib = bibtex(pub);
const description = d.blurb ?? `${d.title} (${d.venueShort}).`;
const hasEqual = d.authors.some((a) => a.equal);
const publisher = d.doi ?? (d.url && d.url !== d.arxiv ? d.url : undefined);
const notes = [d.format, d.presentation, d.status].filter(Boolean).join(' · ');
---
<Base title={d.shortTitle ?? d.title} description={description} image={d.teaser ?? '/images/profile.jpg'} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ScholarlyArticle', headline: d.title,
      author: d.authors.map((a) => ({ '@type': 'Person', name: a.name })), datePublished: String(d.year),
      isPartOf: { '@type': 'PublicationEvent', name: d.venue },
      ...(d.doi ? { sameAs: d.doi } : {}), ...(d.teaser ? { image: new URL(d.teaser, Astro.site).toString() } : {}),
    })} />
  </Fragment>

  <article class="paper">
    <a class="back" href="/publications">← publications</a>
    <h1>{d.title}</h1>
    {d.titleEn && <p class="en-title">{d.titleEn}</p>}
    <Authors authors={d.authors} />
    {hasEqual && <p class="small muted" style="font-size: 0.75rem; margin: 0.1rem 0 0"><sup>†</sup> equal contribution</p>}
    <p class="pub-venue">{d.venue}{d.pages ? `, pp. ${d.pages}` : ''}<br /><span class="note">{d.venueShort} · {notes}</span></p>
    {d.award && <p class="pub-award">🏆 {d.award}</p>}
    <div class="detail-meta">
      {d.pdf && <a href={d.pdf} target="_blank" rel="noopener"><Icons name="pdf" />PDF</a>}
      {publisher && <a href={publisher} target="_blank" rel="noopener"><Icons name="doi" />{publisherLabel(publisher)}{d.doi ? ' (DOI)' : ''}</a>}
      {d.arxiv && <a href={d.arxiv} target="_blank" rel="noopener"><Icons name="arxiv" />arXiv</a>}
      {d.conferenceUrl && <a href={d.conferenceUrl} target="_blank" rel="noopener"><Icons name="link" />{d.conferenceName ?? 'Conference'}</a>}
      {d.scholar && <a href={d.scholar} target="_blank" rel="noopener"><Icons name="scholar" />Google Scholar</a>}
      {!d.pdf && !publisher && !d.arxiv && !d.conferenceUrl && <span class="small muted">Links will be added once the paper is published.</span>}
    </div>

    {d.teaser && (
      <figure class="figure">
        <img src={d.teaser} alt={d.teaserAlt ?? d.title} width="1400" />
        {d.teaserAlt && <figcaption>{d.teaserAlt}</figcaption>}
      </figure>
    )}

    <p class="section-title"><span><span class="emoji">📝</span>{d.abstractSource === 'official' ? 'Abstract' : 'Overview'}</span></p>
    <div class="prose"><Content /></div>
    {d.abstractSource === 'overview' && <p class="notice">The official abstract will be posted once the paper is published. This overview is a short description of the work.</p>}

    {d.areas.length > 0 && <div class="kw interests">{d.areas.map((a) => <span class="tag">{a}</span>)}</div>}

    <div class="bib">
      <div class="bib-head"><p class="section-title" style="margin: 0; border: 0; padding: 0"><span><span class="emoji">🔖</span>BibTeX</span></p><button class="copy" type="button" data-copy>Copy</button></div>
      <pre><code>{bib}</code></pre>
    </div>

    <nav class="pager" aria-label="Adjacent publications">
      {prev ? <a href={`/publications/${prev.id}`}><span>← Newer</span><b>{prev.data.shortTitle ?? prev.data.title}</b></a> : <span />}
      {next ? <a class="r" href={`/publications/${next.id}`}><span>Older →</span><b>{next.data.shortTitle ?? next.data.title}</b></a> : <span />}
    </nav>
  </article>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const code = document.querySelector('.bib code');
  btn?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(code?.textContent ?? ''); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1500); }
    catch { btn.textContent = 'Select & copy'; }
  });
</script>
