---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Authors from '../../components/Authors.astro';
import Icons from '../../components/Icons.astro';
import { getPubs, bibtex } from '../../lib/pubs';
import { publisherLabel } from '../../lib/links';

export async function getStaticPaths() {
  const pubs = await getPubs();
  return pubs.map((pub, i) => ({ params: { slug: pub.id }, props: { pub, prev: pubs[i - 1] ?? null, next: pubs[i + 1] ?? null } }));
}

const { pub, prev, next } = Astro.props;
const d = pub.data;
const { Content } = await render(pub);
const bib = bibtex(pub);
const description = `${d.title} (${d.venueShort}). ${d.authors.map((a) => a.name).join(', ')}.`;
const hasEqual = d.authors.some((a) => a.equal);
const publisher = d.doi ?? (d.url && d.url !== d.arxiv ? d.url : undefined);
const pubLabel = publisherLabel(publisher);
---
<Base title={d.title} description={description} image={d.teaser ?? '/images/profile.jpg'} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ScholarlyArticle', headline: d.title,
      author: d.authors.map((a) => ({ '@type': 'Person', name: a.name })), datePublished: String(d.year),
      isPartOf: { '@type': 'PublicationEvent', name: d.venue },
      ...(d.doi ? { sameAs: d.doi } : {}), ...(d.teaser ? { image: new URL(d.teaser, Astro.site).toString() } : {}),
    })} />
  </Fragment>

  <article class="paper">
    <div class="crumbs"><a href="/publications">Publications</a> / {d.venueShort}</div>
    <h1>{d.title}</h1>
    {d.titleEn && <div class="en-title">{d.titleEn}</div>}
    <Authors authors={d.authors} />
    {hasEqual && <div class="small muted" style="margin-top: 0.15rem"><sup>†</sup> equal contribution</div>}
    <div class="venue-line" style="margin-top: 0.7rem">
      <span class="vtag">{d.venueShort}</span>
      <span>{d.venue}{d.pages ? `, pp. ${d.pages}` : ''}</span>
    </div>
    <div class="venue-line" style="margin-top: 0.4rem">
      {d.award && <span class="award">🏆 {d.award}</span>}
      <span class="stat">{d.format}{d.presentation ? ` · ${d.presentation}` : ''}{d.status ? ` · ${d.status}` : ''}</span>
    </div>
    <div class="actions">
      {d.pdf && <a class="btn pri" href={d.pdf} target="_blank" rel="noopener"><Icons name="pdf" /> PDF</a>}
      {publisher && <a class:list={['btn', { pri: !d.pdf }]} href={publisher} target="_blank" rel="noopener"><Icons name="doi" /> {pubLabel}{d.doi ? ' (DOI)' : ''}</a>}
      {d.arxiv && <a class:list={['btn', { pri: !d.pdf && !publisher }]} href={d.arxiv} target="_blank" rel="noopener"><Icons name="arxiv" /> arXiv</a>}
      {d.conferenceUrl && <a class="btn" href={d.conferenceUrl} target="_blank" rel="noopener"><Icons name="link" /> {d.conferenceName ?? 'Conference site'}</a>}
      {d.scholar && <a class="btn" href={d.scholar} target="_blank" rel="noopener"><Icons name="scholar" /> Google Scholar</a>}
      {!d.pdf && !publisher && !d.arxiv && !d.conferenceUrl && <span class="small muted">Links will be added once the paper is published.</span>}
    </div>


    {d.teaser && (
      <figure class="figure">
        <img src={d.teaser} alt={d.teaserAlt ?? d.title} width="1400" />
        {d.teaserAlt && <figcaption>{d.teaserAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <h2>{d.abstractSource === 'official' ? 'Abstract' : 'Overview'}</h2>
      <Content />
    </div>
    {d.abstractSource === 'overview' && <p class="note">The official abstract will be posted once the paper is published. This overview is a short description of the work.</p>}

    {d.areas.length > 0 && (
      <div class="kw chips">
        {d.areas.map((a) => <span class="chip">{a}</span>)}
      </div>
    )}

    <div class="bib">
      <div class="bib-head"><h3>BibTeX</h3><button class="copy" type="button" data-copy>Copy</button></div>
      <pre><code>{bib}</code></pre>
    </div>

    <nav class="pager" aria-label="Adjacent publications">
      {prev ? <a href={`/publications/${prev.id}`}><span>← Newer</span><b>{prev.data.title}</b></a> : <span />}
      {next ? <a class="r" href={`/publications/${next.id}`}><span>Older →</span><b>{next.data.title}</b></a> : <span />}
    </nav>
  </article>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const code = document.querySelector('.bib code');
  btn?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(code?.textContent ?? ''); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1500); }
    catch { btn.textContent = 'Select & copy'; }
  });
</script>
