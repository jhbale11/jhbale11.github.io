---
interface Author { name: string; me?: boolean; equal?: boolean }
interface Props { authors: Author[]; inline?: boolean; class?: string }
const { authors, inline = false, class: cls } = Astro.props;
const Tag = inline ? 'span' : 'div';
---
<Tag class:list={['authors', cls]}>
  {authors.map((a, i) => (
    <><span class:list={{ me: a.me }}>{a.name}</span>{a.equal && <sup>†</sup>}{i < authors.length - 1 ? ', ' : ''}</>
  ))}
</Tag>
