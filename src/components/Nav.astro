---
import { site } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/', label: 'home' },
  { href: '/publications', label: 'publications' },
  { href: '/cv', label: 'cv' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="nav">
  <div class="wrap nav-in">
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a href={site.scholar} target="_blank" rel="noopener">scholar<span class="ext">↗</span></a>
    </nav>
  </div>
</header>
