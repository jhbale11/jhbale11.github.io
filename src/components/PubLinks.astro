---
import Icons from './Icons.astro';
interface Props { slug: string; doi?: string; url?: string; pdf?: string; arxiv?: string; showPage?: boolean }
const { slug, doi, url, pdf, arxiv, showPage = true } = Astro.props;
const external = url && url !== doi && url !== arxiv ? url : undefined;
---
<div class="links">
  {showPage && <a class="pri" href={`/publications/${slug}`}><Icons name="page" /> Paper page</a>}
  {pdf && <a href={pdf} target="_blank" rel="noopener"><Icons name="pdf" /> PDF</a>}
  {doi && <a href={doi} target="_blank" rel="noopener"><Icons name="doi" /> DOI</a>}
  {arxiv && <a href={arxiv} target="_blank" rel="noopener"><Icons name="arxiv" /> arXiv</a>}
  {external && <a href={external} target="_blank" rel="noopener"><Icons name="link" /> Link</a>}
</div>
