---
interface Props { name: 'mail' | 'scholar' | 'linkedin' | 'github' | 'cv' | 'pdf' | 'doi' | 'arxiv' | 'link' | 'page' | 'ext' | 'video' }
const { name } = Astro.props;
const a = { viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'mail' && <svg {...a}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>}
{name === 'scholar' && <svg {...a}><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>}
