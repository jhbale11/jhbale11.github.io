---
import type { CollectionEntry } from 'astro:content';
import Authors from './Authors.astro';
import PubLinks from './PubLinks.astro';

interface Props { pub: CollectionEntry<'publications'>; showThumb?: boolean }
const { pub, showThumb = true } = Astro.props;
const d = pub.data;
const href = `/publications/${pub.id}`;
const hasThumb = showThumb && !!d.teaser;
---
<li class:list={['pub', { 'has-thumb': hasThumb }]} data-category={d.category} data-first={d.category === 'first-author' ? '1' : '0'}>
  {hasThumb && (
    <a class="thumb" href={href} aria-hidden="true" tabindex="-1"><img src={d.teaser} alt="" loading="lazy" /></a>
  )}
  <div class="pub-main">
    {d.award && <div class="pub-top"><span class="award">🏆 {d.award}</span></div>}
    <div class="pub-title">
      <a href={href}>{d.title}</a>
      {d.titleEn && <span class="en">{d.titleEn}</span>}
    </div>
    <Authors authors={d.authors} />
    <div class="venue-line">
      <span class="vtag">{d.venueShort}</span>
      <span>{d.format}{d.presentation ? ` · ${d.presentation}` : ''}</span>
      {d.status && <span class="stat">· {d.status}</span>}
    </div>
    <PubLinks slug={pub.id} doi={d.doi} url={d.url} pdf={d.pdf} arxiv={d.arxiv} scholar={d.scholar} conferenceUrl={d.conferenceUrl} />
  </div>
</li>
